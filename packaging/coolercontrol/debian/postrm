#!/bin/sh
set -e
if { [ "$1" = "remove" ] || [ "$1" = "purge" ]; } && [ -d /run/systemd/system ]; then
    # Drop the plugin from coolercontrold; aocd takes the fans back when the
    # plugin's connection closes.
    if systemctl is-active --quiet coolercontrold 2>/dev/null; then
        systemctl restart coolercontrold || true
    fi
fi
